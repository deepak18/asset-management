# Base URL of the versioned REST API the browser talks to (§9 frontend/API separation).
# Include the scheme and host only; route paths (/api/v1/..., /health) are added by the client.
# Copy this file to `.env.local` and adjust for your environment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "enabled" to run the UI against the in-browser MSW mocks (no live backend).
# Leave unset/empty to call the real API at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MOCKING=enabled
