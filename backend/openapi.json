                }
              }
            }
          }
        }
      }
    },
    "/api/v1/portfolios/{portfolio_id}/positions": {
      "post": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Add Positions",
        "description": "Record current-holding snapshots as opening BUY lots (404 if absent).\n\nThis is the fast on-ramp for an existing portfolio: assert each position's\nticker, quantity, and cost basis instead of re-keying years of trades.",
        "operationId": "add_positions_api_v1_portfolios__portfolio_id__positions_post",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Portfolio Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PositionSnapshot"
                },
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerIngestResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/portfolios/{portfolio_id}/imports": {
      "post": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Create Import",
        "description": "Accept a broker statement and process it in the background.\n\nReturns ``202 Accepted`` immediately with a ``PENDING`` job \u2014 a decade-long\nexport can hold thousands of rows, far too slow to finish inside the request.\nPoll ``GET /portfolios/{id}/imports/{job_id}`` until the status is terminal,\nthen refetch analytics.\n\nThe upload's declared ``content_type`` is untrusted browser metadata, so the\nformat comes from ``source_format`` and the parser validates the actual bytes.\nRe-uploading identical content is rejected with ``409`` (it would double-count\nthe whole ledger); pass ``allow_duplicate=true`` to override deliberately.",
        "operationId": "create_import_api_v1_portfolios__portfolio_id__imports_post",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Portfolio Id"
            }
          },
          {
            "name": "source_format",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/StatementFormat",
              "default": "robinhood_csv"
            }
          },
          {
            "name": "allow_duplicate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Allow Duplicate"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_import_api_v1_portfolios__portfolio_id__imports_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementImportStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Portfolio"
        ],
        "summary": "List Imports",
        "description": "Return the portfolio's import history, newest first.",
        "operationId": "list_imports_api_v1_portfolios__portfolio_id__imports_get",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Portfolio Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StatementImportStatus"
                  },
                  "title": "Response List Imports Api V1 Portfolios  Portfolio Id  Imports Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/portfolios/{portfolio_id}/imports/{job_id}": {
      "get": {
        "tags": [
          "Portfolio"
        ],
        "summary": "Get Import",
        "description": "Return one import job's live status/progress (the endpoint the UI polls).",
        "operationId": "get_import_api_v1_portfolios__portfolio_id__imports__job_id__get",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Portfolio Id"
            }
          },
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatementImportStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health",
        "description": "Liveness probe \u2014 cheap check that the app is up (no DB touch).",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllocationWeight": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "market_value": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Market Value"
          },
          "weight": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "key",
          "market_value",
          "weight"
        ],
        "title": "AllocationWeight",
        "description": "One row of an allocation breakdown."
      },
      "Body_create_import_api_v1_portfolios__portfolio_id__imports_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_import_api_v1_portfolios__portfolio_id__imports_post"
      },
      "CostBasisResult": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "open_quantity": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Open Quantity"
          },
          "open_cost_basis_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Open Cost Basis Base"
          },
          "realized_pnl_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Realized Pnl Base"
          },
          "dividends_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Dividends Base"
          },
          "fees_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Fees Base"
          },
          "open_lots": {
            "items": {
              "$ref": "#/components/schemas/OpenLot"
            },
            "type": "array",
            "title": "Open Lots"
          }
        },
        "type": "object",
        "required": [
          "ticker",
          "open_quantity",
          "open_cost_basis_base",
          "realized_pnl_base",
          "dividends_base",
          "fees_base",
          "open_lots"
        ],
        "title": "CostBasisResult",
        "description": "Outcome of replaying a ticker's ledger under FIFO lot accounting."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldingInfo": {
        "properties": {
          "ticker": {
            "type": "string",
            "minLength": 1,
            "title": "Ticker"
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector"
          },
          "industry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          }
        },
        "type": "object",
        "required": [
          "ticker"
        ],
        "title": "HoldingInfo",
        "description": "A tracked security's classification metadata (provider output).\n\nGrouping keys for allocation roll-ups; the market value is joined in later once\nthe market-data layer (\u00a71.3) can price the position."
      },
      "ImportStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "RUNNING",
          "SUCCEEDED",
          "FAILED"
        ],
        "title": "ImportStatus",
        "description": "Lifecycle of an asynchronous statement import."
      },
      "LedgerIngestResult": {
        "properties": {
          "portfolio_id": {
            "type": "integer",
            "title": "Portfolio Id"
          },
          "created_transactions": {
            "type": "integer",
            "title": "Created Transactions"
          },
          "tickers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tickers"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          },
          "source_format": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StatementFormat"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "portfolio_id",
          "created_transactions",
          "tickers"
        ],
        "title": "LedgerIngestResult",
        "description": "What a write/import operation actually recorded (the endpoint's response)."
      },
      "OpenLot": {
        "properties": {
          "trade_date": {
            "type": "string",
            "format": "date",
            "title": "Trade Date"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantity"
          },
          "cost_per_share_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Cost Per Share Base"
          }
        },
        "type": "object",
        "required": [
          "trade_date",
          "quantity",
          "cost_per_share_base"
        ],
        "title": "OpenLot",
        "description": "An unclosed FIFO purchase lot, valued in the portfolio base currency."
      },
      "PortfolioAnalytics": {
        "properties": {
          "portfolio": {
            "$ref": "#/components/schemas/PortfolioSummary"
          },
          "base_currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Base Currency"
          },
          "positions": {
            "items": {
              "$ref": "#/components/schemas/CostBasisResult"
            },
            "type": "array",
            "title": "Positions"
          },
          "realized_pnl_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Realized Pnl Base"
          },
          "dividends_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Dividends Base"
          },
          "fees_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Fees Base"
          },
          "open_cost_basis_base": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Open Cost Basis Base"
          },
          "money_weighted_return": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Money Weighted Return"
          },
          "positions_unrealized": {
            "items": {
              "$ref": "#/components/schemas/UnrealizedResult"
            },
            "type": "array",
            "title": "Positions Unrealized",
            "default": []
          },
          "market_value_base": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Value Base"
          },
          "unrealized_pnl_base": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unrealized Pnl Base"
          },
          "allocation_by_ticker": {
            "items": {
              "$ref": "#/components/schemas/AllocationWeight"
            },
            "type": "array",
            "title": "Allocation By Ticker",
            "default": []
          },
          "allocation_by_sector": {
            "items": {
              "$ref": "#/components/schemas/AllocationWeight"
            },
            "type": "array",
            "title": "Allocation By Sector",
            "default": []
          },
          "allocation_by_industry": {
            "items": {
              "$ref": "#/components/schemas/AllocationWeight"
            },
            "type": "array",
            "title": "Allocation By Industry",
            "default": []
          },
          "unpriced_tickers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unpriced Tickers",
            "default": []
          },
          "priced_as_of": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Priced As Of"
          }
        },
        "type": "object",
        "required": [
          "portfolio",
          "base_currency",
          "positions",
          "realized_pnl_base",
          "dividends_base",
          "fees_base",
          "open_cost_basis_base"
        ],
        "title": "PortfolioAnalytics",
        "description": "Aggregated, base-currency portfolio analytics (the service layer's output).\n\nThis is the single typed envelope the ``/analytics`` endpoint returns. It bundles\nthe portfolio identity, per-position FIFO cost-basis results, whole-portfolio\nroll-up totals, and the money-weighted return (XIRR).\n\n``money_weighted_return`` is ``None`` when XIRR is mathematically undefined\n(e.g. an empty ledger, or flows that never change sign) \u2014 we surface \"not\ncomputable\" honestly rather than emitting a misleading ``0``. It is a *rate*\n(annualized fraction), not money, but is kept as ``Decimal`` so no ``float``\nleaks into a financial payload.\n\nMarket-value-dependent figures \u2014 per-position unrealized P&L and allocation\nweights \u2014 are populated when the market-data provider supplies current\nprices. When prices are unavailable (no provider configured, quota exhausted,\nor a missing FX rate) those fields degrade gracefully: totals are ``None``,\nallocation lists are empty, and the affected tickers are reported in\n``unpriced_tickers`` so the omission is explicit, never a silent ``0``."
      },
